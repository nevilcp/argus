# Exclude development and runtime files to keep the Docker build context small.

.git/
.github/
.claude/
.venv/
venv/
env/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Persist generated state in runtime volumes instead of baking it into images.
data/
chroma_db/
runs/
*.db
*.sqlite
*.sqlite3

docs/
langsmith/
tests/

.env
.env.*
!.env.example

# Keep README.md and LICENSE available for package build metadata.
*.md
!README.md
CONTRIBUTING.md
