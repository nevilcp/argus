# syntax=docker/dockerfile:1

# Declared once so both stages below always share the same base image.
ARG PYTHON_IMAGE=python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

# Build native dependencies and prefetch models; update the pinned digest manually to refresh the base image.
FROM ${PYTHON_IMAGE} AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# README.md and LICENSE are read by pyproject.toml's readme/license metadata
COPY pyproject.toml README.md LICENSE .
COPY argus/ ./argus/
COPY api/ ./api/
COPY scripts/ ./scripts/

# Use CPU wheels to avoid downloading unused CUDA dependencies.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        ".[models]"

ENV HF_HOME=/opt/model-cache
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" && \
    python -c "from transformers import pipeline; pipeline( \
        task='text-classification', model='ProsusAI/finbert', tokenizer='ProsusAI/finbert')" && \
    chmod -R a+rX /opt/model-cache

FROM ${PYTHON_IMAGE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 argus

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/model-cache /opt/model-cache
# Application packages are installed inside the copied venv.

# Use baked models offline so the non-root process never tries to update its read-only cache.
ENV PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/opt/model-cache \
    HF_HUB_OFFLINE=1 \
    PYTHONUNBUFFERED=1

# Embed build identity so decision provenance survives :latest tags and deployment rollbacks.
ARG ARGUS_IMAGE_TAG=unknown
ENV ARGUS_IMAGE_TAG=${ARGUS_IMAGE_TAG}

RUN mkdir -p /app/data /app/chroma_db /app/runs && chown -R argus:argus /app
USER argus

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=90s \
    CMD curl -f http://localhost:8000/health || exit 1

# Keep one worker because quota governance and the kill switch are process-local; startup guards enforce exclusivity.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
