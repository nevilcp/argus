# LLM providers — technical/fundamental/sentiment/portfolio agent synthesis
GROQ_API_KEY=

# Market & economic data — macro regime indicators (CPI, Fed Funds, UNRATE, yield curve)
FRED_API_KEY=

# News & sentiment — headlines for FinBERT sentiment scoring
NEWSAPI_KEY=

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=argus
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Production-consequential: unset means the deployment is wide open ──────
# Shared secret required via the X-API-Key header on POST /analyze and
# POST /kill-switch/reset. Blank (the default) disables the check entirely —
# fine for local development behind a trusted network boundary, never for a
# deployment reachable outside one.
# ARGUS_API_KEY=
#
# Comma-separated allowed CORS origins for the FastAPI gateway. Defaults to
# "*" (any origin) — narrow this before exposing the API beyond localhost.
# ARGUS_CORS_ORIGINS=https://your-frontend.example.com

# ─── Universe & storage ──────────────────────────────────────────────────────
# ARGUS_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN
# ARGUS_DATA_DIR=data
# ARGUS_CHROMA_DIR=data/chroma_db
# ARGUS_RUNS_DIR=data/runs
# MFT_CANDLE_INTERVAL=1m
# CANDLE_BUFFER_SIZE=

# ─── Unattended operation ────────────────────────────────────────────────────
# ARGUS_COLLECTOR_ENABLED=false
# ARGUS_COLLECTOR_INTERVAL_SECONDS=3600
# ARGUS_RECONCILE_ENABLED=false
# ARGUS_RECONCILE_HOUR_ET=17
# ARGUS_TOTAL_WEALTH=100000
# ARGUS_INVEST_PCT=0.6
# ARGUS_RISK_TOLERANCE=MODERATE

# ─── LLM model selection (each must be a member of REGISTERED_MODELS in
# argus/orchestration/governor.py, asserted at API startup) ──────────────────
# ARGUS_FUNDAMENTAL_MODEL=openai/gpt-oss-120b
# ARGUS_SENTIMENT_MODEL=openai/gpt-oss-20b
# ARGUS_PORTFOLIO_MODEL=openai/gpt-oss-120b

# ─── Groq rate-governor bootstrap floor, corrected per-model once Groq's
# response headers report the account's real tier ────────────────────────────
# ARGUS_GROQ_RPM=30
# ARGUS_GROQ_TPM=6000
# ARGUS_ANALYZE_DEADLINE_SECONDS=360

# ─── Portfolio hard limits enforced by RiskStatisticalEngine ────────────────
# MAX_SINGLE_POSITION_PCT=0.15
# MAX_SECTOR_CONCENTRATION=0.40
# MAX_PORTFOLIO_BETA=1.50
# VIX_BLACKOUT_THRESHOLD=35
# LOOKBACK_DAYS=252

# ─── Misc ────────────────────────────────────────────────────────────────────
# ARGUS_LOG_LEVEL=INFO
# ARGUS_HMM_MODEL_PATH=argus/models/macro_hmm.joblib
# TECHNICAL_INDICATOR_WEIGHTS is a JSON object (see argus/params.py); not
# meant to be overridden via .env — edit argus/params.py instead.
# ARGUS_IMAGE_TAG is baked in at Docker build time (see Dockerfile.api); do
# not set it by hand.
