# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Never commit .env — it holds real secrets. Every field below defaults to
# an empty string or a safe fallback in argus/config.py, so the process
# starts without any of them; the feature that depends on a missing key
# degrades or is skipped rather than crashing.

# ─── LLM providers ──────────────────────────────────────────────────────────
# REQUIRED — technical/fundamental/sentiment/portfolio agent synthesis
GROQ_API_KEY=

# ─── Market & economic data ─────────────────────────────────────────────────
# REQUIRED — macro regime indicators (CPI, Fed Funds, UNRATE, yield curve)
FRED_API_KEY=

# ─── News & sentiment ────────────────────────────────────────────────────────
# REQUIRED — headlines for FinBERT sentiment scoring
NEWSAPI_KEY=
# Google Trends sentiment needs no API key.

# ─── LangSmith tracing (optional) ───────────────────────────────────────────
# Uncomment to trace LLM calls at smith.langchain.com. Read directly by
# langchain-core, not by argus/config.py — ARGUS itself has no code path
# that touches these.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=argus
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Unattended operation (optional) ────────────────────────────────────────
# Every value below is commented out at its Settings default; uncomment to
# override. See the README's Deployment section for what these control.
# ARGUS_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN
# ARGUS_DATA_DIR=data
# ARGUS_CHROMA_DIR=data/chroma_db
# ARGUS_RUNS_DIR=data/runs
# ARGUS_COLLECTOR_ENABLED=false
# ARGUS_COLLECTOR_INTERVAL_SECONDS=3600
# ARGUS_RECONCILE_ENABLED=false
# ARGUS_RECONCILE_HOUR_ET=17
# ARGUS_TOTAL_WEALTH=100000
# ARGUS_INVEST_PCT=0.6
# ARGUS_RISK_TOLERANCE=MODERATE
# ARGUS_CORS_ORIGINS=*
# ARGUS_API_KEY=
# ARGUS_LOG_LEVEL=INFO
# ARGUS_HMM_MODEL_PATH=argus/models/macro_hmm.joblib
# ARGUS_GROQ_RPM=30
# ARGUS_GROQ_TPM=6000
# ARGUS_FUNDAMENTAL_MODEL=openai/gpt-oss-120b
# ARGUS_SENTIMENT_MODEL=openai/gpt-oss-20b
# ARGUS_PORTFOLIO_MODEL=openai/gpt-oss-120b
