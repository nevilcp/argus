# Groq powers fundamental, sentiment, and portfolio judgments; technical, macro, and risk stay statistical.
GROQ_API_KEY=

# Market & economic data - macro regime indicators (CPI, Fed Funds, UNRATE, yield curve)
FRED_API_KEY=

# News & sentiment - headlines for FinBERT sentiment scoring
NEWSAPI_KEY=

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=argus
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Require X-API-Key on mutating routes outside a trusted local boundary; a blank key disables authentication.
# ARGUS_API_KEY=
# Restrict comma-separated CORS origins before exposing the gateway; the default wildcard permits any origin.
# ARGUS_CORS_ORIGINS=https://your-frontend.example.com

# ARGUS_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN
# ARGUS_DATA_DIR=data
# ARGUS_CHROMA_DIR=data/chroma_db
# ARGUS_RUNS_DIR=data/runs
# MFT_CANDLE_INTERVAL=1m
# Buffer depth derives from MFT_CANDLE_INTERVAL when this override is unset.
# CANDLE_BUFFER_SIZE=1173

# ARGUS_COLLECTOR_ENABLED=false
# ARGUS_COLLECTOR_INTERVAL_SECONDS=3600
# ARGUS_RECONCILE_ENABLED=false
# ARGUS_RECONCILE_HOUR_ET=17
# ARGUS_TOTAL_WEALTH=100000
# ARGUS_INVEST_PCT=0.6
# ARGUS_RISK_TOLERANCE=MODERATE

# Require model IDs registered in argus/governor.py; startup validates them before serving requests.
# ARGUS_FUNDAMENTAL_MODEL=openai/gpt-oss-120b
# ARGUS_SENTIMENT_MODEL=openai/gpt-oss-20b
# ARGUS_PORTFOLIO_MODEL=openai/gpt-oss-120b

# Use bootstrap quotas until provider response headers reveal per-model limits.
# ARGUS_GROQ_RPM=30
# ARGUS_GROQ_TPM=6000
# ARGUS_ANALYZE_DEADLINE_SECONDS=360

# MAX_SINGLE_POSITION_PCT=0.15
# MAX_SECTOR_CONCENTRATION=0.40
# MAX_PORTFOLIO_BETA=1.50
# VIX_BLACKOUT_THRESHOLD=35

# ARGUS_LOG_LEVEL=INFO
# ARGUS_HMM_MODEL_PATH=argus/models/macro_hmm.joblib
# Edit indicator weights and their provenance in argus/params.py instead of overriding them in .env.

# Set capacity and retention in params.py; preserve deployed candle interval and buffer variable names.
